TOGETHER_API_KEY=your_together_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Canonical site origin used for metadata, Open Graph/Twitter images, robots,
# and the sitemap. Set this to the production domain (e.g. https://example.com).
# If unset, the app falls back to VERCEL_URL (per-deploy URL) and then to
# http://localhost:3000 for local dev, so set it for any real deployment.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
