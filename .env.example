TOGETHER_API_KEY=your_together_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Canonical site origin used for metadata, Open Graph/Twitter images, robots,
# and the sitemap. Optional override: production builds default to
# https://www.aibrowsergames.io and dev defaults to http://localhost:3000.
# Set it only when deploying the site under a different domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
